      "observed_at": "2026-11-23T14:00:59Z",
      "evidence": [
        {
          "@id": "urn:okf:ai-capability-governance:evidence:send",
          "type": "Pinned public source passage",
          "url": "https://cyberdudeuk.github.io/ai-capability-governance/#ch-worked",
          "resource": "https://github.com/cyberdudeuk/ai-capability-governance/blob/9dd855ecfd8aece1b87c49eff2096b2d13d3fc98/index.html",
          "source_artifact": "source/snapshots/em-index.html.gz (uncompressed hash)",
          "source_sha256": "7576330b94fcdb8bfcd43493d65000f1944fc55312effe085cc0f768877e44a1",
          "source_field": "#ch-worked",
          "locator": "Variant where the agent sends its reply",
          "source_value": "The agent sends the reply itself Tier moves + Irreversible Tier 4 · Critical Q1 · Automate with sampling L1 · Draft only — a person edits and commits every output One word in the mandate — send rather than draft — and an effect exists that no later correction undoes. Autonomy is forced to draft-only regardless of tier, and shadow mode becomes mandatory. This is the most common scope change requested after go-live, and the cheapest one to refuse.",
          "source_value_sha256": "371ae30faf1c127718431c951a134234b07d0ae434bd9ffc35ed08e2e3ecfb05",
          "source_value_hash_canonicalization": "UTF-8; collapsed Unicode whitespace; trimmed",
          "retrieved_at": "2026-11-23T14:00:59Z"
        }
      ],
