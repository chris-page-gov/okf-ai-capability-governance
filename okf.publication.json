{
  "schema": "okf-repository-publication-contract.v1",
  "repository": {
    "name": "okf-ai-capability-governance",
    "role": "governed-producer",
    "root_index": "generated/site-bundle/index.md",
    "lifecycle": "public-pilot"
  },
  "semantic_contract": {
    "path": "okf.semantic.json",
    "profile": "urn:okf:ai-capability-governance:profile:v1"
  },
  "boundaries": {
    "authored": [
      "source/",
      "profiles/",
      "scripts/"
    ],
    "generated": [
      "generated/",
      "downloads/",
      "_site/"
    ],
    "excluded": [
      "generated/"
    ]
  },
  "publication": {
    "authorised": true,
    "targets": [
      "https://github.com/chris-page-gov/okf-ai-capability-governance",
      "https://chris-page-gov.github.io/okf-ai-capability-governance/"
    ],
    "release_status": "public-pilot",
    "pages": {
      "url": "https://chris-page-gov.github.io/okf-ai-capability-governance/",
      "branch": "main",
      "workflow": ".github/workflows/validate.yml",
      "artifact": "_site/",
      "discovery": ".well-known/okf.json",
      "manifest": "publication.json"
    }
  },
  "validation": {
    "graph": "scripts/build.py --check",
    "core": "installed guarded okf-plus-generate validator",
    "consumer": "installed guarded okf-plus-consume scanner and offline browser",
    "source_archive": "scripts/build_site.py --check",
    "downloads": "scripts/check_downloads.py",
    "pages": "scripts/build_pages.py --check",
    "deployed_pages": "scripts/verify_pages.py"
  }
}
